            '(-h --help)'{-h,--help}'[Display help]' \
            ':name:_claude_mcp_servers'
          ;;
        *)
          _message 'no more arguments'
          ;;
      esac
    fi
    return
    ;;
  plugin|plugins)
    if (( CURRENT == 2 )); then
      _describe 'plugin command' plugin_commands
    else
      subcmd2=$words[2]
      shift words; (( CURRENT-- ))
      case $subcmd2 in
        configure)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--json[Output as JSON]' \
            '--values-stdin[Read option values from stdin as a JSON object of single-line strings; options left out keep their values]' \
            ':plugin:_claude_installed_plugins'
          ;;
        details)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            ':name:_claude_installed_plugins'
          ;;
        tag)
          _arguments \
            '--dry-run[Print what would be tagged without creating it]' \
            '(-f --force)'{-f,--force}'[Skip the dirty-working-tree and tag-already-exists checks]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-m --message)'{-m,--message}'[Tag annotation message (use %s for the version)]:msg:' \
            '--push[Push the tag to --remote after creating it]' \
            '--remote[Remote to push to with --push (default: origin)]:name:' \
            '::path:_files'
          ;;
        test)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '::dir:_files -/'
          ;;
        validate)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--json[Output the validation report as JSON (same exit codes)]' \
            '--profile[Also exit 1 when the plugin directory would refuse a submission of the plugin on a check this command runs]:profile:(directory)' \
            '--strict[Treat warnings as errors (exit 1). Use in CI to fail on unrecognized fields, missing metadata, and other issues that the runtime tolerates]' \
            ':path:_files'
          ;;
        eval)
          # `eval init` is its own command with its own flags, and it may
          # come after eval flags (`plugin eval --verbose init --bare`). So
          # find the first word before the cursor that is neither an option
          # nor an option's value, and see whether it is `init`. The values
          # have to be skipped, or `--case init` would count: one word for
          # most options, one word if there is one for `--json [path]`, and
          # every word up to the next option for the `<value...>` ones.
          # Keep these lists in step with the eval options below.
          local -a eval_value_opts=(--ablation --case -j --concurrency
            --eval-dir --judge-model --max-cost-usd --mocks --model --output-dir
            --report --runs --threshold)
          local -a eval_optional_value_opts=(--json)
          local -a eval_multi_value_opts=(--allow-tools --disallow-tools --tag)
          i=2
          while (( i < CURRENT )); do
            if (( ${eval_value_opts[(Ie)$words[i]]} )); then
              (( i += 2 ))
            elif (( ${eval_optional_value_opts[(Ie)$words[i]]} )); then
              (( i++ ))
              (( i < CURRENT )) && [[ $words[i] != -* ]] && (( i++ ))
            elif (( ${eval_multi_value_opts[(Ie)$words[i]]} )); then
              (( i++ ))
              while (( i < CURRENT )) && [[ $words[i] != -* ]]; do
                (( i++ ))
              done
            elif [[ $words[i] == -* ]]; then
              (( i++ ))
            else
              break
            fi
          done
          if (( i < CURRENT )) && [[ $words[i] == init ]]; then
            shift $(( i - 1 )) words
            (( CURRENT -= i - 1 ))
            _arguments \
              '--bare[Write a blank template (prompt.md + graders/criteria.md) instead of running the interview]' \
              '--eval-dir[Directory (below the current directory) to write cases into (default: experimental.evals from the plugin.json in the current directory, else evals/)]:dir:_files -/' \
              '(-h --help)'{-h,--help}'[Display help]' \
              '(-i --interactive)'{-i,--interactive}'[Run the authoring interview (already the default in a terminal); requires an interactive terminal]' \
              '::name:'
          else
            # The action is in braces because `_arguments` passes compadd
            # options to a bare action, and `_alternative` rejects them.
