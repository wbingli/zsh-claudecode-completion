# Find the subcommand position by scanning for the first non-flag argument after the command name.
# This handles cases where flags appear before the subcommand (e.g., alias claude='claude --flag').
# Only words before the cursor count: the word being completed is not a
# subcommand yet, and words after it must not change what is offered here.
local subcmd_pos=0
local subcmd="" subcmd2="" subcmd3=""
# Every name in claude_commands must have a branch in the case statement below.
local -a known_commands=(${claude_commands%%:*})
local i
for (( i=2; i < CURRENT; i++ )); do
  # Skip flags and their values
  [[ "$words[$i]" == -* ]] && continue
  # Check if this word is a known subcommand
  if (( ${known_commands[(Ie)$words[$i]]} )); then
    subcmd_pos=$i
    subcmd="$words[$i]"
    break
  fi
done

# If no subcommand found yet, fall through to main _arguments
if [[ -n "$subcmd" ]]; then
# Drop everything before the subcommand so that $words[1] is the subcommand
# itself. `_arguments` counts positionals from $words[2], so each block
# below can list its own arguments without accounting for `claude` or for
# flags an alias put in front. Nested levels shift once more for the same
# reason, right before their own `case`.
shift $(( subcmd_pos - 1 )) words
(( CURRENT -= subcmd_pos - 1 ))

case $subcmd in
  agents)
    _arguments -s \
      '*--add-dir[Additional directory to allow tool access to in dispatched sessions (repeatable)]:directory:_files -/' \
      '--agent[Default agent for sessions dispatched from agent view. Overrides the agent setting]:agent:_claude_agents' \
      '--all[With --json: also include completed background sessions]' \
      '--allow-dangerously-skip-permissions[Make bypass-permissions mode available to dispatched sessions without defaulting to it]' \
      '--cwd[Show only background sessions started under path]:path:_files -/' \
      '--dangerously-skip-permissions[Alias for --permission-mode bypassPermissions]' \
      '--effort[Default effort level for sessions dispatched from agent view]:level:(low medium high xhigh max ultracode)' \
      '(-h --help)'{-h,--help}'[Display help for command]' \
      '--json[Print active sessions (interactive and background) as a JSON array and exit (for scripting; does not require a TTY)]' \
      '*--mcp-config[MCP server configuration to apply to dispatched sessions (repeatable)]:config:_files' \
      '--model[Default model for sessions dispatched from agent view]:model:_claude_models' \
      '--permission-mode[Default permission mode for sessions dispatched from agent view]:mode:(acceptEdits auto bypassPermissions manual dontAsk plan)' \
      '*--plugin-dir[Load plugins from specified directory for the agent view and dispatched sessions (repeatable)]:path:_files -/' \
      '--restricted[Start dispatched sessions in restricted mode]' \
      '--setting-sources[Comma-separated list of setting sources to load (user, project, local)]:sources:_values -s , source user project local' \
      '--settings[Settings file or JSON string to apply to the agent view and dispatched sessions]:file-or-json:_files' \
      '--strict-mcp-config[Only use MCP servers from --mcp-config in dispatched sessions]'
    return
    ;;
  attach|logs|stop|kill)
    _arguments \
      '(-h --help)'{-h,--help}'[Display help for command]' \
      ':session:_claude_background_session_ids'
    return
    ;;
  rm)
    _arguments \
      '--discard-unpushed[Also discard the worktree'\''s unpushed commits (and any uncommitted changes) while it is still the same worktree at that commit - pass the value a previous claude rm <id> reported]:commit@worktree-id:' \
      '--force-remove-worktree[Delete the worktree directory even though the WorktreeRemove hook or git couldn'\''t remove it - pass the value a previous claude rm <id> reported]:worktree-id:' \
      '(-h --help)'{-h,--help}'[Display help for command]' \
      ':session:_claude_background_session_ids'
    return
    ;;
  respawn)
    _arguments \
      '(--all)--all[Restart every stopped session]' \
      '(-h --help)'{-h,--help}'[Display help for command]' \
      '(--all):session:_claude_background_session_ids'
    return
    ;;
  auth)
    if (( CURRENT == 2 )); then
      _describe 'auth command' auth_commands
    else
      subcmd2=$words[2]
      shift words; (( CURRENT-- ))
      case $subcmd2 in
        login)
          _arguments \
            '--claudeai[Use Claude subscription (default)]' \
            '--console[Use Anthropic Console (API usage billing) instead of Claude subscription]' \
            '--email[Pre-populate email address on the login page]:email:' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--sso[Force SSO login flow]'
          ;;
        logout)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]'
          ;;
        status)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--json[Output as JSON (default)]' \
            '--text[Output as human-readable text]'
          ;;
        *)
          _message 'no more arguments'
          ;;
      esac
    fi
    return
    ;;
  mcp)
    if (( CURRENT == 2 )); then
      _describe 'mcp command' mcp_commands
    else
      subcmd2=$words[2]
      shift words; (( CURRENT-- ))
      case $subcmd2 in
        serve)
          _arguments \
            '(-d --debug)'{-d,--debug}'[Enable debug mode]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--verbose[Override verbose mode setting from config]'
          ;;
        add)
          _arguments \
            '--callback-port[Fixed port for OAuth callback (for servers requiring pre-registered redirect URIs)]:port:' \
            '--client-id[OAuth client ID for HTTP/SSE servers]:clientId:' \
            '--client-secret[Prompt for OAuth client secret (or set MCP_CLIENT_SECRET env var)]' \
            '(-e --env)*'{-e,--env}'[Set environment variables (e.g. -e KEY=value)]:env:' \
            '(-H --header)*'{-H,--header}'[Set headers for HTTP/SSE servers (e.g. -H "X-Api-Key: abc123" -H "X-Custom: value")]:header:' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (local, user, or project) (default: local)]:scope:(local user project)' \
            '(-t --transport)'{-t,--transport}'[Transport type (stdio, sse, http). Defaults to stdio if not specified]:transport:(stdio sse http)' \
            ':name:' \
            ':commandOrUrl:_files' \
            '*:args:_files'
          ;;
        remove)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (local, user, or project) - if not specified, removes from whichever scope it exists in]:scope:(local user project)' \
            ':name:_claude_mcp_servers'
          ;;
        add-json)
          _arguments \
            '--client-secret[Prompt for OAuth client secret (or set MCP_CLIENT_SECRET env var)]' \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (local, user, or project) (default: local)]:scope:(local user project)' \
            ':name:' \
            ':json:'
          ;;
        add-from-claude-desktop)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '(-s --scope)'{-s,--scope}'[Configuration scope (local, user, or project) (default: local)]:scope:(local user project)'
          ;;
        get)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            ':name:_claude_mcp_servers'
          ;;
        list|reset-project-choices)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]'
          ;;
        login)
          _arguments \
            '(-h --help)'{-h,--help}'[Display help]' \
            '--no-browser[Print the authorization URL instead of opening a browser (for SSH/headless sessions - paste the redirect URL back when prompted)]' \
            ':name:_claude_mcp_servers'
